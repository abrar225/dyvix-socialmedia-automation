# ==========================================
# Dyvix Social Media Automation Configuration
# ==========================================

# 1. Research Engine Keys
TAVILY_API_KEY="your-tavily-api-key"
FIRECRAWL_API_KEY="your-firecrawl-api-key"

# 2. LLM Engine Keys (Gemini or NVIDIA NIM)
GOOGLE_AI_STUDIO_API_KEY="your-google-ai-studio-api-key"
GEMINI_API_KEY="your-gemini-api-key"
NVIDIA_API_KEY="your-nvidia-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"

# 3. Visual Engine Configuration (4:5 Portrait)
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1350
IMAGE_MODEL=flux
POLLINATIONS_BASE_URL="https://image.pollinations.ai/prompt"

# 4. n8n Distribution & Webhook
N8N_BASE_URL="https://flow.dyvix.net"
N8N_MCP_URL="https://flow.dyvix.net/mcp-server/http"
N8N_API_KEY="your-n8n-api-key"
N8N_WEBHOOK_URL="https://flow.dyvix.net/webhook/social-media-publish"

# 5. Human-in-the-Loop Review & Notifications
RESEND_API_KEY="your-resend-api-key"
RESEND_SENDER="automation@opsmentum.online"
REVIEWER_EMAIL="moabrarakhunji@gmail.com"
REVIEW_SERVER_PORT=5050
